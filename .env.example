ENV=dev
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=gemma4:31b-cloud
LLM_REASONING=false
LLM_NUM_CTX=262144
LLM_NUM_PREDICT=8192
OLLAMA_KEEP_ALIVE=0
MEMORY_SWAP_MODE=false
REFERENCE_LLM_MODEL=gemma4:31b-cloud
REFERENCE_LLM_BASE_URL=http://ollama:11434
REFERENCE_LLM_REASONING=false

# --- Эмбеддинги ---
EMBEDDING_BACKEND=sentence_transformers
EMBED_MODEL=ai-sage/Giga-Embeddings-instruct
EMBEDDING_DIMENSIONS=2048
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_TOKENS=4096
EMBEDDING_QUERY_INSTRUCTION=Дан тип и описание сделки, необходимо найти текст, где описывается похожая сделка
EMBEDDING_TRUST_REMOTE_CODE=true
EMBEDDING_PRECISION=bfloat16
EMBEDDING_QUERY_INSTRUCTION_DISABLED=
PRELOAD_EMBEDDINGS_ON_STARTUP=false

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_GENERAL=npa_general
QDRANT_COLLECTION_PRIMAL=npa_primal
QDRANT_COLLECTION_SECONDARY=npa_secondary

# --- Классификация сделки ---
CLASSIFY_RAG_ASSIST_ENABLED=true
CLASSIFY_RAG_ASSIST_MAX_QUERIES=3
CLASSIFY_RAG_ASSIST_TOP_K_PER_QUERY=5

# --- Retrieval ---
RETRIEVAL_CANDIDATE_TOP_K=80
RETRIEVAL_CONTEXT_TOP_K=12
RETRIEVAL_GENERAL_TOP_K=8
RETRIEVAL_SECONDARY_ENRICHMENT_TOP_K=5
RECOMMENDATION_ENRICHMENT_MAX_ITEMS=6
# Reference-graph expansion: после реранка PRIMAL подтягиваем чанки по
# LLM-извлечённым ссылкам и реранжируем объединённый набор
RETRIEVAL_REFERENCE_MAX_HOPS=3
RETRIEVAL_REFERENCE_HOP_CHUNK_CAP=20
RETRIEVAL_REFERENCE_ARTICLE_CHUNK_CAP=20
RETRIEVAL_SPECIFIC_EXPANDED_TOP_K=30
# LLM-фильтр поверх retrieve_specific
RETRIEVAL_FILTER_ENABLED=true
RETRIEVAL_FILTER_TEXT_PREVIEW_CHARS=600
# Размер батча для LLM-фильтра. 0 — один вызов на все чанки
RETRIEVAL_FILTER_BATCH_SIZE=10

# --- Альтернативный итеративный путь retrieve_norms ---
RETRIEVAL_ITERATIVE_ENABLED=false
# RETRIEVAL_ITERATIVE_TARGET_ARTICLES=20
# RETRIEVAL_ITERATIVE_MAX_QUERIES=10
# RETRIEVAL_ITERATIVE_TOP_K_PER_QUERY=10
# RETRIEVAL_ITERATIVE_VAGUE_ENRICHMENT_MAX_ITEMS=6

# --- Follow-up sub-agent ---
FOLLOWUP_SUBAGENT_MAX_ATTEMPTS=5
FOLLOWUP_SUBAGENT_TOP_K=10

# --- Реранкер (Qwen3-Reranker / BGE) ---
RERANKER_ENABLED=true
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cuda
RERANKER_BATCH_SIZE=2
RERANKER_PRECISION=bfloat16
RERANKER_TASK_INSTRUCTION=
RERANKER_MAX_LENGTH=2048

# --- LangGraph ---
LANGGRAPH_API_URL=http://langgraph_dev:2024
LANGGRAPH_ASSISTANT_ID=contract_agent
MAX_ITERATIONS=10
MAX_CLASSIFICATION_CLARIFICATIONS=10
RUN_TIMEOUT_SECONDS=600

# --- LangSmith ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=  
LANGSMITH_PROJECT=diploma-agent

# --- Включает дамп результата работы агента (только узлов генерации договора и рекомендаций) ---
LLM_DUMP_FINAL_ENABLED=false
LLM_DUMP_FINAL_DIR=data/llm_dumps

# --- S3 / MinIO ---
S3_ENABLED=true # если выключить, то договоры будут сохраняться на диске
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=contracts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PRESIGN_EXPIRES_SECONDS=3600

# --- Сессии ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax
FRONTEND_ORIGINS=http://localhost:3000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Яндекс OAuth ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback

# --- Seed-админ / владелец ---
# SEED_ADMIN_EMAIL получает все кейсы, в которых не указан юзернейм при первой миграции.
SEED_ADMIN_EMAIL=admin@local
# Владелец авторизуется напрямую через env-переменные, в БД строки нет.
# OWNER_* имеют приоритет; ADMIN_* — обратно-совместимый fallback.
OWNER_USERNAME=
OWNER_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Админ-NPA (загрузка нормативных актов) ---
ADMIN_NPA_BUCKET=admin-npa
ADMIN_NPA_MAX_UPLOAD_MB=50

# --- Платежный шлюз (YooKassa) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
YOOKASSA_RETURN_URL=http://localhost:3000/billing/return
